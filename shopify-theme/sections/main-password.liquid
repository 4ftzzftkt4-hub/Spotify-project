<section class="page-head" style="min-height:70vh;display:grid;place-items:center"><div class="wrap narrow" style="text-align:center">
  <span class="logo" style="display:inline-block;margin-bottom:28px">{{ settings.brand_name | default: shop.name }}</span>
  <h1 class="h1">Opening soon.</h1>
  {%- if shop.password_message != blank %}<p>{{ shop.password_message }}</p>{% endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div style="display:flex;gap:10px;max-width:420px;margin:28px auto 0"><label class="sr-only" for="pw">Password</label><input class="input" id="pw" type="password" name="password" placeholder="Password"><button class="btn btn--dark" type="submit">Enter</button></div>
  {%- endform -%}
</div></section>
{% schema %}{ "name": "Password" }{% endschema %}
