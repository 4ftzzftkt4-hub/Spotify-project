<header class="page-head"><div class="wrap"><h1 class="h1">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:480px;margin:24px auto 0"><label class="sr-only" for="q">Search</label><input class="input" id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search"></form>
</div></header>
<section class="section"><div class="wrap narrow">
  {%- if search.performed -%}
    {%- for item in search.results -%}<p><a class="link" href="{{ item.url }}">{{ item.title }}</a></p>{%- else -%}<p>No results for “{{ search.terms }}”.</p>{%- endfor -%}
  {%- endif -%}
</div></section>
{% schema %}{ "name": "Search" }{% endschema %}
