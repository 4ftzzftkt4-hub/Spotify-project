{%- if section.settings.show_title -%}
<header class="page-head"><div class="wrap"><h1 class="h1">{{ page.title }}</h1></div></header>
{%- endif -%}
{%- if page.content != blank -%}
<section class="section"><div class="wrap narrow prose rte">{{ page.content }}</div></section>
{%- endif -%}
{% schema %}
{ "name": "Page content", "settings": [ { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true } ] }
{% endschema %}
