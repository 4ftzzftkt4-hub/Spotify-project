<section class="section section--dark" id="guide" aria-labelledby="steps-{{ section.id }}">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow" style="color:var(--champagne)">{{ section.settings.eyebrow }}</span>
      <h2 id="steps-{{ section.id }}" class="h1">{{ section.settings.heading }}</h2>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" data-reveal data-reveal-delay="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="caps">Step {{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<div class="fine rte" style="text-align:center;margin-top:48px;color:#a59d92">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How personalisation works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make it mean something." },
    { "type": "richtext", "id": "note", "label": "Note" }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Make it yours" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ] }],
  "max_blocks": 3,
  "presets": [{ "name": "Steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] }]
}
{% endschema %}
