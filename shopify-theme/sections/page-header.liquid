<header class="page-head">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif -%}
    <h1 class="h1">{{ section.settings.heading | default: page.title | newline_to_br }}</h1>
    {%- if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif -%}
  </div>
</header>
{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
