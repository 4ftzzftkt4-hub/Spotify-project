<header class="page-head"><div class="wrap"><h1 class="h1">{{ blog.title }}</h1></div></header>
<section class="section"><div class="wrap narrow">
  {%- paginate blog.articles by 10 -%}{%- for article in blog.articles -%}<article style="margin-bottom:40px"><h2 class="h3"><a href="{{ article.url }}">{{ article.title }}</a></h2><p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 200 }}</p></article>{%- endfor -%}{%- endpaginate -%}
</div></section>
{% schema %}{ "name": "Blog" }{% endschema %}
