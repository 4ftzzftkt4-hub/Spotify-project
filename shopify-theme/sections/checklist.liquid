<section class="section section--ivory" aria-labelledby="chk-{{ section.id }}">
  <div class="wrap">
    <div class="section-head" data-reveal><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 id="chk-{{ section.id }}" class="h2">{{ section.settings.heading }}</h2></div>
    <ul class="checklist" data-reveal>
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
    </ul>
    {%- if section.settings.callout != blank %}<p class="callout" data-reveal>{{ section.settings.callout }}</p>{% endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Checklist",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A few details before you make it yours." },
    { "type": "textarea", "id": "callout", "label": "Callout", "default": "Your personalisation matters. Please double-check every detail before placing your order." }
  ],
  "blocks": [{ "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Check the spelling of every name and word." } ] }],
  "presets": [{ "name": "Checklist", "blocks": [ { "type": "item" } ] }]
}
{% endschema %}
