<section class="section {{ section.settings.background }}" aria-labelledby="feat-{{ section.id }}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 id="feat-{{ section.id }}" class="h2">{{ section.settings.heading }}</h2>
    </div>
    {%- endif -%}
    <div class="features" data-reveal>
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          {%- if section.settings.numbered %}<span class="num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{% endif -%}
          <h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Feature grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What makes it special" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The details that matter." },
    { "type": "checkbox", "id": "numbered", "label": "Show numbers", "default": false },
    { "type": "select", "id": "background", "label": "Background", "default": "", "options": [ { "value": "", "label": "Paper" }, { "value": "section--ivory", "label": "Ivory" } ] }
  ],
  "blocks": [{ "type": "feature", "name": "Feature", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ] }],
  "presets": [{ "name": "Feature grid", "blocks": [ { "type": "feature" }, { "type": "feature" }, { "type": "feature" } ] }]
}
{% endschema %}
