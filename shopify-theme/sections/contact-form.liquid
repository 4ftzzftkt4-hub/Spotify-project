<section class="section">
  <div class="wrap contact-grid">
    <div>
      <h2 class="h3">{{ section.settings.heading }}</h2>
      <div class="topic-list">
        {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>{%- endfor -%}
      </div>
      {%- if section.settings.email != blank %}<p style="margin-top:28px">Or email us at <a href="mailto:{{ section.settings.email }}" style="text-decoration:underline">{{ section.settings.email }}</a>.</p>{% endif -%}
    </div>
    {%- form 'contact', id: 'contact-form' -%}
      {%- if form.posted_successfully? -%}<p class="preview-note" role="status">Thanks — your message has been sent. We’ll be in touch soon.</p>{%- endif -%}
      {%- if form.errors -%}<p class="preview-note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="c-topic">Topic</label>
        <select class="input" id="c-topic" name="contact[Topic]"><option>Personalisation enquiry</option><option>Order enquiry</option><option>Damaged or incorrect item</option><option>Something else</option></select></div>
      <div class="field"><label for="c-name">Name</label><input class="input" id="c-name" name="contact[name]" autocomplete="name" required value="{{ form.name }}"></div>
      <div class="field"><label for="c-email">Email</label><input class="input" id="c-email" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="c-order">Order number (if you have one)</label><input class="input" id="c-order" name="contact[Order number]"></div>
      <div class="field"><label for="c-msg">Message</label><textarea class="input" id="c-msg" name="contact[body]" required>{{ form.body }}</textarea></div>
      <button class="btn btn--dark" type="submit">Send message</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How can we help?" },
    { "type": "text", "id": "email", "label": "Support email (optional)" }
  ],
  "blocks": [{ "type": "topic", "name": "Topic", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Personalisation" }, { "type": "text", "id": "text", "label": "Text" } ] }],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
