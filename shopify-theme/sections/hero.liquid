<section class="hero" aria-labelledby="hero-{{ section.id }}">
  <div class="hero__copy">
    {%- if section.settings.eyebrow != blank %}<span class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>{% endif -%}
    <h1 id="hero-{{ section.id }}" class="display" data-reveal data-reveal-delay="1">{{ section.settings.heading | newline_to_br }}</h1>
    <p class="lead" data-reveal data-reveal-delay="2">{{ section.settings.text }}</p>
    <div class="hero__ctas" data-reveal data-reveal-delay="3">
      {%- if section.settings.button_1 != blank %}<a class="btn btn--dark" href="{{ section.settings.link_1 | default: routes.all_products_collection_url }}">{{ section.settings.button_1 }}</a>{% endif -%}
      {%- if section.settings.button_2 != blank %}<a class="btn btn--ghost" href="{{ section.settings.link_2 | default: '#details' }}">{{ section.settings.button_2 }}</a>{% endif -%}
    </div>
  </div>
  <div class="hero__visual">{% render 'visual', s: section.settings, alt: section.settings.alt %}</div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Signature Round Necklace" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A little\npiece of you." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A timeless stainless steel necklace, personalised to carry the details that mean the most to you." },
    { "type": "text", "id": "button_1", "label": "Primary button", "default": "Create your necklace" },
    { "type": "url", "id": "link_1", "label": "Primary link" },
    { "type": "text", "id": "button_2", "label": "Secondary button", "default": "Discover the details" },
    { "type": "url", "id": "link_2", "label": "Secondary link" },
    { "type": "text", "id": "alt", "label": "Image description", "default": "A woman wearing the silver round pendant necklace" },
    { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "asset", "label": "Or bundled photo", "default": "engraving", "options": [
        { "value": "engraving", "label": "Engraved disc (live)" },
        { "value": "hero.jpg", "label": "Worn — linen shirt" },
        { "value": "onmodel.jpg", "label": "Gold on collarbone" },
        { "value": "macro.jpg", "label": "Mirror edge macro" },
        { "value": "gift.jpg", "label": "Gifting — hands & ribbon" },
        { "value": "life-knit.jpg", "label": "Everyday — knit" },
        { "value": "life-shirt.jpg", "label": "Layered — white shirt" },
        { "value": "life-evening.jpg", "label": "Evening — black dress" }
      ] },
      { "type": "text", "id": "engrave_text", "label": "Engraved disc: text", "info": "Separate lines with |" },
      { "type": "select", "id": "finish", "label": "Engraved disc: finish", "default": "steel", "options": [ { "value": "steel", "label": "Silver" }, { "value": "gold", "label": "Gold" }, { "value": "rose", "label": "Rose gold" } ] },
      { "type": "select", "id": "font", "label": "Engraved disc: lettering", "default": "classic", "options": [ { "value": "classic", "label": "Classic" }, { "value": "modern", "label": "Modern" }, { "value": "script", "label": "Script" }, { "value": "minimal", "label": "Minimal" } ] },
      { "type": "range", "id": "zoom", "label": "Engraved disc: zoom", "min": 1, "max": 2.5, "step": 0.1, "default": 1.3 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
