{%- comment -%}
  Welcome pop-up: sign up for emails, get a first-order discount code.
  Uses Shopify's built-in customer form, so sign-ups appear in Customers
  as email subscribers, tagged "newsletter" and "welcome-popup".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign shop_url = settings.signature_product.url | default: routes.all_products_collection_url
  assign apply_url = '/discount/' | append: s.code | append: '?redirect=' | append: shop_url | append: '%23personalise'
-%}
{%- if s.enabled and s.code != blank -%}
<div class="nl-popup" id="nl-popup" role="dialog" aria-modal="true" aria-labelledby="nl-title" hidden
  data-delay="{{ s.delay }}" data-snooze-days="{{ s.snooze_days }}" data-design-mode="{{ request.design_mode }}">
  <div class="nl-popup__scrim" data-nl-close></div>
  <div class="nl-popup__card">
    <button type="button" class="icon-btn nl-popup__close" data-nl-close aria-label="Close">✕</button>
    <div class="nl-popup__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy' }}
      {%- else -%}
        <img src="{{ 'onmodel.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="1117">
      {%- endif -%}
    </div>
    <div class="nl-popup__body">
      {%- form 'customer', id: 'nl-popup-form', class: 'nl-popup__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="nl-popup__done" data-nl-success>
            <span class="eyebrow">{{ s.success_eyebrow }}</span>
            <h2 class="h2" id="nl-title">{{ s.success_heading }}</h2>
            <p>{{ s.success_text }}</p>
            <div class="nl-code">
              <span class="nl-code__value" id="nl-code">{{ s.code }}</span>
              <button type="button" class="btn btn--ghost nl-code__copy" data-nl-copy>Copy</button>
            </div>
            <a class="btn btn--dark btn--block" href="{{ apply_url }}">Create your necklace</a>
            <p class="fine">Your code is applied automatically when you use the button above.</p>
          </div>
        {%- else -%}
          <span class="eyebrow">{{ s.eyebrow }}</span>
          <h2 class="h2" id="nl-title">{{ s.heading }}</h2>
          <p>{{ s.text }}</p>
          <input type="hidden" name="contact[tags]" value="newsletter, welcome-popup">
          <div class="field">
            <label for="nl-email">Email</label>
            <input class="input" id="nl-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" required placeholder="you@example.com">
          </div>
          {%- if form.errors -%}
            <p class="nl-popup__error" role="alert">
              {%- if form.errors contains 'email' -%}Please check your email address — it looks like it may already be subscribed or isn’t valid.{%- else -%}{{ form.errors | default_errors }}{%- endif -%}
            </p>
          {%- endif -%}
          <button class="btn btn--dark btn--block" type="submit">{{ s.button }}</button>
          <p class="fine">{{ s.legal }}</p>
          <button type="button" class="link-btn nl-popup__no" data-nl-close>No thanks</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>
<script src="{{ 'newsletter-popup.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Welcome pop-up",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the pop-up", "default": true },
    { "type": "text", "id": "code", "label": "Discount code to reveal", "default": "WELCOME10", "info": "Must match a discount code in Discounts." },
    { "type": "range", "id": "delay", "label": "Show after (seconds)", "min": 3, "max": 60, "step": 1, "unit": "s", "default": 10 },
    { "type": "range", "id": "snooze_days", "label": "If dismissed, show again after (days)", "min": 1, "max": 60, "step": 1, "default": 14 },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the gold necklace close-up." },
    { "type": "header", "content": "Sign-up step" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first necklace." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join our list for a welcome code, plus first word on new finishes and gifting dates." },
    { "type": "text", "id": "button", "label": "Button", "default": "Get my 10% off" },
    { "type": "textarea", "id": "legal", "label": "Consent note", "default": "By signing up you agree to receive marketing emails from us. Unsubscribe anytime. One use per customer, on your first order." },
    { "type": "header", "content": "After signing up" },
    { "type": "text", "id": "success_eyebrow", "label": "Eyebrow", "default": "You’re on the list" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "Here’s your 10% off." },
    { "type": "textarea", "id": "success_text", "label": "Text", "default": "Use this code at checkout on your first order." }
  ]
}
{% endschema %}
