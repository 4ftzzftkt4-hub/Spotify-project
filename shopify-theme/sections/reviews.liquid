<section class="section" aria-labelledby="rev-{{ section.id }}">
  <div class="wrap narrow">
    <div class="section-head" style="margin-bottom:40px"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 id="rev-{{ section.id }}" class="h2">{{ section.settings.heading }}</h2></div>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
    {%- else -%}
      <div class="reviews-empty">
        <p class="h3" style="margin:0">{{ section.settings.empty_title }}</p>
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In their words." },
    { "type": "text", "id": "empty_title", "label": "No-reviews title", "default": "Our first reviews are on their way." },
    { "type": "textarea", "id": "empty_text", "label": "No-reviews text", "default": "We only publish genuine reviews from verified customers. They’ll appear here as our first necklaces reach their new owners." },
    { "type": "paragraph", "content": "Install a reviews app (e.g. Judge.me) and add its block here. Never add reviews that aren’t from real customers." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
