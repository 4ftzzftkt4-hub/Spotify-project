{%- comment -%}
  Renders a merchant-chosen image, or falls back to a bundled theme photo.
  Params: image (image object or blank), fallback (asset filename), alt, class, sizes, eager
{%- endcomment -%}
{%- if image != blank -%}
  {{ image | image_url: width: 1600 | image_tag: alt: alt, class: class, sizes: sizes, loading: 'lazy', widths: '480, 800, 1200, 1600' }}
{%- elsif fallback != blank -%}
  <img src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" class="{{ class }}" {% unless eager %}loading="lazy"{% endunless %} width="1280" height="1589">
{%- endif -%}
