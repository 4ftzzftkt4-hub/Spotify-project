<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="section wrap" style="min-height:70svh;display:grid;align-content:center;gap:1.5rem;max-width:34rem">
      <p class="label">{{ settings.brand_name | default: shop.name }}</p>
      <h1 class="h2">Opening soon.</h1>
      {{ content_for_layout }}
    </main>
  </body>
</html>
