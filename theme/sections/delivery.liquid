{%- comment -%}
  Delivery. Every figure comes from theme settings — the theme never states a
  price or a transit time of its own. Empty settings are hidden and an honest
  "contact us" line is shown instead.
{%- endcomment -%}
{%- liquid
  assign has_any = false
  if settings.ship_lead_stock != blank or settings.ship_lead_custom != blank or settings.ship_pickup != blank
    assign has_any = true
  endif
-%}

<section class="section section--paper2" id="delivery">
  <div class="wrap">
    <div class="split-media">
      <div class="reveal">
        <div class="sec-head">
          <div class="sec-head__meta">
            <span class="index">{{ section.settings.index }}</span>
            <span class="label">{{ section.settings.label }}</span>
          </div>
          <h2 class="h1">{{ section.settings.heading }}</h2>
        </div>
        <div class="body-copy lede" style="margin-top:1.5rem;max-width:46ch">{{ section.settings.body }}</div>

        <div class="cta-band__actions" style="margin-top:2rem">
          {%- if section.settings.cta_url != blank or settings.email != blank -%}
            <a
              class="btn"
              href="{% if section.settings.cta_url != blank %}{{ section.settings.cta_url }}{% else %}mailto:{{ settings.email }}?subject=Shipping%20enquiry{% endif %}">
              {{ section.settings.cta_label | default: 'Check shipping' }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="reveal" data-reveal-delay="80">
        <table class="spec-table" style="background:var(--white);border:1px solid var(--line)">
          <caption class="visually-hidden">Delivery details</caption>
          <tbody>
            <tr>
              <th scope="row">Where we ship</th>
              <td>{{ section.settings.regions }}</td>
            </tr>
            <tr>
              <th scope="row">Shipping cost</th>
              <td>{{ settings.ship_note | default: 'Calculated at checkout based on your delivery address.' }}</td>
            </tr>
            {%- if settings.ship_lead_stock != blank -%}
              <tr><th scope="row">Dispatch — standard sizes</th><td>{{ settings.ship_lead_stock }}</td></tr>
            {%- endif -%}
            {%- if settings.ship_lead_custom != blank -%}
              <tr><th scope="row">Lead time — custom drains</th><td>{{ settings.ship_lead_custom }}</td></tr>
            {%- endif -%}
            {%- if settings.ship_pickup != blank -%}
              <tr><th scope="row">Pickup</th><td>{{ settings.ship_pickup }}</td></tr>
            {%- endif -%}
            <tr>
              <th scope="row">Long items</th>
              <td>{{ section.settings.oversize }}</td>
            </tr>
          </tbody>
        </table>

        {%- unless has_any -%}
          <p class="form-note" style="margin-top:1rem">
            Dispatch and lead times are not published yet. Ask us for a current timeframe before you order —
            we would rather tell you than guess.
          </p>
        {%- endunless -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Delivery",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "15" },
    { "type": "text", "id": "label", "label": "Label", "default": "Delivery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipped Australia-wide." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Linear drains are long, so they are packed and handled as oversized freight. Enter your address at checkout to see the cost for your delivery.</p>"
    },
    { "type": "text", "id": "regions", "label": "Regions", "default": "Australia-wide" },
    {
      "type": "text",
      "id": "oversize",
      "label": "Oversized items note",
      "default": "Packed as oversized freight; delivery to a street address is required for longer drains."
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Check shipping" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Delivery" }]
}
{% endschema %}
