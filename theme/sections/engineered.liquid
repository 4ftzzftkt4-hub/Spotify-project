<section class="section section--dark on-dark" id="engineered">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2.5rem,5vw,4rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="eng">
      <div class="eng__media reveal">
        <div class="frame frame--43 frame--dark">
          {%- render 'media',
            image: section.settings.image,
            url: section.settings.image_url,
            alt: section.settings.image_alt,
            sizes: '(min-width: 72em) 40vw, 100vw',
            placeholder_label: 'Engineering photography',
            placeholder_note: 'Cross braces, wedge wire and edge bars'
          -%}
        </div>
        {%- if section.settings.caption != blank -%}
          <p class="label" style="margin-top:1rem">{{ section.settings.caption }}</p>
        {%- endif -%}
      </div>

      <div class="eng__list">
        {%- for block in section.blocks -%}
          <div class="eng__item reveal" data-reveal-delay="{{ forloop.index0 | times: 60 }}" {{ block.shopify_attributes }}>
            <div class="eng__item-head">
              <span class="eng__item-n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="h3">{{ block.settings.title }}</h3>
            </div>
            <div class="body-copy" style="padding-left:2.5rem;max-width:56ch">{{ block.settings.body }}</div>
            {%- if block.settings.specs != blank -%}
              <div class="eng__specs" style="padding-left:2.5rem">
                {%- assign specs = block.settings.specs | split: ',' -%}
                {%- for s in specs -%}
                  {%- assign s = s | strip -%}
                  {%- if s != blank -%}<span class="eng__spec">{{ s }}</span>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Engineered construction",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "03" },
    { "type": "text", "id": "label", "label": "Label", "default": "How it's made" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built like a drain. Designed like architectural hardware."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Every element below is part of the published specification — not a marketing claim."
    },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "Fully welded body · formed drainage base · removable grate" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL", "default": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-engineering-base.jpg" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Fully welded stainless steel drain body with formed drainage base and centre outlet, grate removed"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Construction detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "specs", "label": "Spec chips", "info": "Comma separated." }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "item",
        "settings": {
          "title": "304 stainless steel",
          "body": "<p>The drain is made from 304 stainless steel and is intended for internal applications — showers, bathrooms and laundries.</p>",
          "specs": "304 grade, Internal use"
        }
      },
      {
        "type": "item",
        "settings": {
          "title": "Wedge wire Heelguard grate",
          "body": "<p>The Heelguard grate is built from 3mm wedge wire at a 4mm aperture, with welded cross braces and a full perimeter edge bar.</p>",
          "specs": "3mm wedge wire, 4mm aperture, Welded cross braces"
        }
      },
      {
        "type": "item",
        "settings": {
          "title": "Perimeter edge bar",
          "body": "<p>A 5mm × 20mm deep edge bar runs the full perimeter of the grate, eliminating sharp edges where the grate meets the tile.</p>",
          "specs": "5mm × 20mm deep"
        }
      },
      {
        "type": "item",
        "settings": {
          "title": "Cross bracing",
          "body": "<p>Cross bars sit at approximately 25mm centres. They hold the wedge wire true and are positioned to maintain water flow through the grate.</p>",
          "specs": "≈25mm centres"
        }
      },
      {
        "type": "item",
        "settings": {
          "title": "Tapered cross bars",
          "body": "<p>The cross bars are tapered rather than square. The taper is designed to reduce the build-up of dirt and grime inside the grate.</p>",
          "specs": "Tapered profile"
        }
      },
      {
        "type": "item",
        "settings": {
          "title": "Fully welded construction",
          "body": "<p>The body is fully welded rather than folded and sealed, and the drainage base is formed to direct water toward the outlet.</p>",
          "specs": "Fully welded, Formed base"
        }
      }
    ]
  },
  "presets": [{ "name": "Engineered construction" }]
}
{% endschema %}
