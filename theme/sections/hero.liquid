{%- liquid
  assign product = section.settings.product
  assign shop_url = section.settings.cta_url
  if shop_url == blank and product != blank
    assign shop_url = product.url
  endif
-%}

<section class="hero on-dark">
  <div class="hero__media">
    {%- render 'media',
      image: section.settings.image,
      url: section.settings.image_url,
      alt: section.settings.image_alt,
      sizes: '100vw',
      priority: true,
      placeholder_label: 'Hero photography',
      placeholder_note: 'Drain installed in a finished shower'
    -%}
  </div>

  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__eyebrow label">{{ section.settings.eyebrow }}</p>

      <h1 class="display hero__title">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="lede hero__lede">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--light btn--lg" href="{{ shop_url | default: '#' }}">
            {{ section.settings.cta_label }}
            <span class="btn__arrow" style="width:16px" aria-hidden="true">{%- render 'icon', name: 'arrow-right' -%}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn--outline-light btn--lg" href="{{ section.settings.cta2_url | default: '#technical' }}">
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="hero__chips">
        <div class="chips">
          {%- assign creds = section.settings.credibility | split: ',' -%}
          {%- for c in creds -%}
            {%- assign c = c | strip -%}
            {%- if c != blank -%}
              <span class="chip"><span class="chip__dot" aria-hidden="true"></span>{{ c }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <span class="hero__scroll" aria-hidden="true">Scroll</span>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Hero product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stainless steel linear drainage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The linear drain, perfected." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium 304 stainless steel linear drainage engineered for modern showers, bathrooms and laundries."
    },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop Heelguard drains" },
    { "type": "url", "id": "cta_url", "label": "Primary link", "info": "Defaults to the hero product." },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "View technical details" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" },
    {
      "type": "textarea",
      "id": "credibility",
      "label": "Credibility indicators",
      "info": "Comma separated. Keep it to facts you can stand behind.",
      "default": "304 Stainless Steel, Fully Welded Construction, Three Profiles, Multiple Outlet Options, Custom Sizes Available, Australia-Wide Shipping"
    },
    { "type": "header", "content": "Photography" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Overrides the image URL below." },
    { "type": "text", "id": "image_url", "label": "Hero image URL", "default": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-hero-shower.jpg" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Hero image alt text",
      "default": "Heelguard stainless steel linear drain set flush in the stone floor of a walk-in shower"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
