{%- comment -%}
  Review section. Reviews are only rendered when a block carries real content.
  With no real reviews supplied, the section renders labelled placeholders so
  the layout can be judged without ever publishing a fabricated testimonial.
{%- endcomment -%}
{%- liquid
  assign real_count = 0
  for block in section.blocks
    if block.settings.quote != blank and block.settings.is_real
      assign real_count = real_count | plus: 1
    endif
  endfor
-%}

<section class="section section--white" id="reviews">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if real_count == 0 -%}
        <p class="lede">{{ section.settings.empty_note }}</p>
      {%- else -%}
        <p class="lede">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="reviews reveal">
      {%- for block in section.blocks -%}
        {%- assign is_real = false -%}
        {%- if block.settings.quote != blank and block.settings.is_real -%}
          {%- assign is_real = true -%}
        {%- endif -%}

        <figure class="review{% unless is_real %} review--placeholder{% endunless %}" {{ block.shopify_attributes }}>
          {%- if is_real -%}
            <div class="stars" aria-label="{{ block.settings.rating }} out of 5">
              {%- assign rating = block.settings.rating | plus: 0 -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}
                  {%- render 'icon', name: 'star' -%}
                {%- else -%}
                  {%- render 'icon', name: 'star-outline' -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <blockquote class="review__quote">{{ block.settings.quote }}</blockquote>
            <figcaption class="review__who">
              <span class="review__name">{{ block.settings.name }}</span>
              {%- if block.settings.project != blank -%}
                <span class="review__proj">{{ block.settings.project }}</span>
              {%- endif -%}
            </figcaption>
          {%- else -%}
            <div class="stars stars--empty" aria-hidden="true">
              {%- for i in (1..5) -%}{%- render 'icon', name: 'star-outline' -%}{%- endfor -%}
            </div>
            <blockquote class="review__quote review__quote--placeholder">
              Customer review placeholder — replace with a real review once you have one.
            </blockquote>
            <figcaption class="review__who">
              <span class="review__name" style="color:var(--ink-40)">Customer name</span>
              <span class="review__proj">Project type</span>
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    {%- if real_count == 0 -%}
      <p class="form-note reveal" style="margin-top:1.5rem;max-width:60ch">
        <strong>Note for the store owner:</strong> these are empty placeholders. Tick “This is a real review” on a
        block and paste the customer's own words to publish it. Nothing here is published as a testimonial until
        you do.
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "14"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "In their words, not ours."
    },
    {
      "type": "textarea",
      "id": "empty_note",
      "label": "Empty-state note",
      "default": "We don't have reviews to show yet. When we do, they'll appear here in the customer's own words — we won't write them ourselves."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_real",
          "label": "This is a real review",
          "default": false,
          "info": "Leave unticked to keep this slot as a labelled placeholder. Never tick it for copy you wrote yourself."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "project",
          "label": "Project type"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {}
        },
        {
          "type": "review",
          "settings": {}
        },
        {
          "type": "review",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
