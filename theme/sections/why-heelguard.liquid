<section class="section" id="why">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2rem,4vw,3.5rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="why reveal">
      {%- for block in section.blocks -%}
        {%- if block.type == 'media' -%}
          <div class="why__card why__card--media" {{ block.shopify_attributes }}>
            {%- render 'media',
              image: block.settings.image,
              url: block.settings.image_url,
              alt: block.settings.image_alt,
              sizes: '(min-width: 72em) 33vw, (min-width: 48em) 50vw, 100vw',
              placeholder_label: 'Photography'
            -%}
          </div>
        {%- else -%}
          <div class="why__card" {{ block.shopify_attributes }}>
            <span class="why__icon">{%- render 'icon', name: block.settings.icon -%}</span>
            <h3 class="h3">{{ block.settings.title }}</h3>
            <div class="body-copy" style="font-size:var(--fs-sm)">{{ block.settings.body }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Heelguard",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "02" },
    { "type": "text", "id": "label", "label": "Label", "default": "Why Heelguard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why the Heelguard pattern." },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "The grate is the part you stand on, clean and look at every day. This is what the pattern changes."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "heel",
          "options": [
            { "value": "heel", "label": "Heel" },
            { "value": "paw", "label": "Paw" },
            { "value": "flow", "label": "Water flow" },
            { "value": "clean", "label": "Cleaning" },
            { "value": "steel", "label": "Steel" },
            { "value": "tools", "label": "Installation" },
            { "value": "weld", "label": "Welding" },
            { "value": "ruler", "label": "Dimensions" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "media",
      "name": "Photograph",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "image_alt", "label": "Alt text" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "card",
        "settings": {
          "icon": "heel",
          "title": "Heel friendly",
          "body": "<p>The wedge wire and tapered cross bars give a more comfortable, practical grate surface underfoot than an open grid.</p>"
        }
      },
      {
        "type": "media",
        "settings": {
          "image_url": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-scale-foot.jpg",
          "image_alt": "A bare foot resting flat on the Heelguard grate, showing the heel-friendly wedge-wire surface"
        }
      },
      {
        "type": "card",
        "settings": {
          "icon": "paw",
          "title": "Pet friendly",
          "body": "<p>Suitable for bathrooms and laundries where pets use the space alongside you.</p>"
        }
      },
      {
        "type": "card",
        "settings": {
          "icon": "flow",
          "title": "Built for water flow",
          "body": "<p>The drainage base is formed to direct water toward the outlet, and the cross bars are positioned to maintain flow through the grate.</p>"
        }
      },
      {
        "type": "card",
        "settings": {
          "icon": "clean",
          "title": "Easy to clean",
          "body": "<p>The grate lifts out, giving direct access to the internal channel for removing hair and debris.</p>"
        }
      },
      {
        "type": "card",
        "settings": {
          "icon": "steel",
          "title": "304 stainless steel",
          "body": "<p>A premium, durable material choice for internal wet areas, with a brushed finish that suits contemporary tapware.</p>"
        }
      },
      {
        "type": "media",
        "settings": {
          "image_url": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-macro-grate.jpg",
          "image_alt": "Macro detail of the Heelguard wedge-wire grate showing the 3mm wire, 4mm aperture and perimeter edge bar"
        }
      },
      {
        "type": "card",
        "settings": {
          "icon": "tools",
          "title": "Designed for installation",
          "body": "<p>Profiles, outlet positions and documentation are shaped by real bathroom installation requirements — not retrofitted to them.</p>"
        }
      },
      {
        "type": "card",
        "settings": {
          "icon": "ruler",
          "title": "Specified up front",
          "body": "<p>Widths, depths, apertures and outlet diameters are published so you can check the drain against your build before ordering.</p>"
        }
      }
    ]
  },
  "presets": [{ "name": "Why Heelguard" }]
}
{% endschema %}
