<section class="section section--dark on-dark" id="trade">
  <div class="wrap">
    <div class="sec-head reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="grid grid--3 reveal" style="margin-bottom:2.5rem">
      {%- for block in section.blocks -%}
        <div class="card card--dark" {{ block.shopify_attributes }}>
          <span class="card__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <p style="font-size:var(--fs-sm);color:var(--steel-light)">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>

    <div class="cta-band reveal" style="align-items:center;border-top:1px solid var(--line-dark);padding-top:2.5rem">
      <div>
        <h3 class="h3">{{ section.settings.cta_heading }}</h3>
        <p class="body-copy" style="margin-top:0.5rem;max-width:46ch">{{ section.settings.cta_body }}</p>
      </div>
      <div class="cta-band__actions">
        {%- assign trade_to = settings.trade_email | default: settings.email -%}
        {%- if section.settings.cta_url != blank or trade_to != blank -%}
          <a
            class="btn btn--light"
            href="{% if section.settings.cta_url != blank %}{{ section.settings.cta_url }}{% else %}mailto:{{ trade_to }}?subject=Trade%20and%20project%20enquiry{% endif %}">
            {{ section.settings.cta_label | default: 'Talk to our team' }}
          </a>
        {%- endif -%}
        {%- if settings.quote_url != blank -%}
          <a class="btn btn--outline-light" href="{{ settings.quote_url }}">Request a quote</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trade",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "16" },
    { "type": "text", "id": "label", "label": "Label", "default": "Trade & projects" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buying for a project?" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Multi-unit builds, custom outlet positions, staged deliveries and documentation for specification — send us the drawings and we'll work from them."
    },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Send us the plans." },
    {
      "type": "textarea",
      "id": "cta_body",
      "label": "CTA body",
      "default": "Quantities, lengths, outlet positions and delivery staging. We'll come back with a written quote and the documentation to go with it."
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Talk to our team" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "title": "Bulk enquiries", "body": "Quantities across a build, quoted as one job rather than line by line." } },
      { "type": "item", "settings": { "title": "Project pricing", "body": "Written quotes against your schedule, with the configuration recorded per unit." } },
      { "type": "item", "settings": { "title": "Custom drains", "body": "Lengths and outlet positions made to suit plumbing that is already set." } },
      { "type": "item", "settings": { "title": "Technical documentation", "body": "Drawings and specification detail for your submission or O&M manual." } },
      { "type": "item", "settings": { "title": "Installation support", "body": "Someone who knows the product, on the phone, while the trades are on site." } },
      { "type": "item", "settings": { "title": "Staged delivery", "body": "Delivered to suit the program instead of all at once to a locked-up site." } }
    ]
  },
  "presets": [{ "name": "Trade" }]
}
{% endschema %}
