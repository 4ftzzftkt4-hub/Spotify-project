{%- comment -%}
  Homepage product hero. Introduces the actual product with real media and a
  link straight into the configurator, rather than repeating the brand pitch.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
-%}

<section class="section section--white" id="product">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ product.title | default: section.settings.fallback_heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="pdp reveal">
      <div class="gal" data-gallery style="position:static">
        <div class="gal__stage">
          <div class="gal__slides" data-gal-slides tabindex="0" role="group" aria-label="Product images">
            {%- if product != blank and product.media.size > 0 -%}
              {%- for media in product.media limit: 8 -%}
                <div class="gal__slide" data-gal-slide data-caption="{{ media.alt | escape }}">
                  {%- render 'media',
                    image: media.preview_image,
                    alt: media.alt,
                    sizes: '(min-width: 64em) 55vw, 100vw',
                    ratio: '4/3',
                    zoomable: true
                  -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="gal__slide">
                <div class="frame frame--43">
                  {%- render 'media', placeholder_label: 'Product photography', placeholder_note: 'Select a product for this section' -%}
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if product != blank and product.media.size > 1 -%}
            <div class="gal__arrows">
              <button class="gal__arrow" type="button" data-gal-prev aria-label="Previous image">
                {%- render 'icon', name: 'arrow-left' -%}
              </button>
              <button class="gal__arrow" type="button" data-gal-next aria-label="Next image">
                {%- render 'icon', name: 'arrow-right' -%}
              </button>
            </div>
            <button class="gal__zoom js-only" type="button" data-gal-zoom>
              <span style="width:14px">{%- render 'icon', name: 'zoom' -%}</span>
              Zoom
            </button>
          {%- endif -%}
        </div>

        {%- if product != blank and product.media.size > 1 -%}
          <div class="gal__dots js-only">
            {%- for media in product.media limit: 8 -%}
              <button class="gal__dot" type="button" data-gal-dot aria-label="Show image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
          <div class="gal__thumbs">
            {%- for media in product.media limit: 6 -%}
              <button class="gal__thumb" type="button" data-gal-thumb aria-label="Show image {{ forloop.index }}">
                <img src="{{ media.preview_image | image_url: width: 240 }}" alt="" width="240" height="240" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div style="display:grid;gap:1.75rem;align-content:start">
        <div class="body-copy lede" style="max-width:44ch">{{ section.settings.body }}</div>

        <table class="spec-table">
          <caption class="visually-hidden">Key specification</caption>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.key }}</th>
                <td>{{ block.settings.value }}</td>
              </tr>
            {%- endfor -%}
            {%- if product != blank -%}
              <tr>
                <th scope="row">Price</th>
                <td>
                  {%- if product.price_varies -%}
                    From {{ product.price_min | money }} {{ cart.currency.iso_code }}
                  {%- else -%}
                    {{ product.price | money }} {{ cart.currency.iso_code }}
                  {%- endif -%}
                </td>
              </tr>
            {%- endif -%}
          </tbody>
        </table>

        <div class="cta-band__actions">
          <a class="btn btn--lg" href="{{ product.url | default: section.settings.cta_url | default: '#' }}">
            {{ section.settings.cta_label }}
            <span class="btn__arrow" style="width:16px" aria-hidden="true">{%- render 'icon', name: 'arrow-right' -%}</span>
          </a>
          {%- if section.settings.cta2_label != blank -%}
            <a class="btn btn--ghost btn--lg" href="{{ section.settings.cta2_url | default: '#technical' }}">
              {{ section.settings.cta2_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "02"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The product"
    },
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "Fallback heading",
      "default": "Stainless Steel Linear Drain — Heelguard Pattern"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "One drain, specified three ways. Choose the profile, the length and the outlet."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>304 stainless steel. Fully welded construction. A Heelguard wedge-wire grate with tapered cross bars and a full perimeter edge bar. Designed for internal showers, bathrooms and laundries.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA",
      "default": "Configure your drain"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary CTA",
      "default": "Technical drawings"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Secondary link"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification row",
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product spotlight",
      "blocks": [
        {
          "type": "spec",
          "settings": {
            "key": "Material",
            "value": "304 stainless steel"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Construction",
            "value": "Fully welded"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Grate",
            "value": "Heelguard wedge wire — 3mm wire, 4mm aperture"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Edge bar",
            "value": "5 × 20mm deep, full perimeter"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Profiles",
            "value": "70 × 22mm · 85 × 20mm · 100 × 20mm"
          }
        },
        {
          "type": "spec",
          "settings": {
            "key": "Application",
            "value": "Internal, pedestrian areas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
