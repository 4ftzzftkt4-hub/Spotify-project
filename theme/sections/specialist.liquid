<section class="section section--paper2" id="specialist">
  <div class="wrap">
    <div class="specialist">
      <div class="sec-head reveal">
        <div class="sec-head__meta">
          <span class="index">{{ section.settings.index }}</span>
          <span class="label">{{ section.settings.label }}</span>
        </div>
        <h2 class="h1">{{ section.settings.heading }}</h2>
      </div>

      <div class="reveal" data-reveal-delay="90" style="display:grid;gap:2rem;align-content:start">
        <div class="body-copy lede" style="max-width:52ch">{{ section.settings.body }}</div>

        <div class="specialist__stats">
          {%- for block in section.blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <p class="stat__k">{{ block.settings.title }}</p>
              <p class="stat__v">{{ block.settings.body }}</p>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.link_label != blank -%}
          <a class="tlink" href="{{ section.settings.link_url | default: '#' }}" style="justify-self:start">
            {{ section.settings.link_label }}
            <span style="width:15px" aria-hidden="true">{%- render 'icon', name: 'arrow-right' -%}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Specialist positioning",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "01"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Why we exist"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One product. Done properly."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>We don't try to be everything to everyone. We specialise in stainless steel linear drainage — which gives us the room to obsess over the details that actually matter.</p><p>From grate construction and water flow to outlet positioning, installation and cleaning, every part of the Heelguard system is designed with the finished bathroom in mind.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "How it's engineered"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "One product"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "Short supporting line."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Specialist positioning",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "One product",
            "body": "The Heelguard linear drain — in three profiles, many lengths and several outlet configurations."
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Built for installers",
            "body": "Profiles, outlets and documentation shaped by how bathrooms are actually built."
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Specified, not guessed",
            "body": "Dimensions, materials and outlet options published up front so you order the right drain the first time."
          }
        }
      ]
    }
  ]
}
{% endschema %}
