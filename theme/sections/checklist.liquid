<section class="section section--dark on-dark" id="before-you-buy" data-checklist-scope>
  <div class="wrap wrap--narrow">
    <div class="sec-head reveal" style="margin-bottom:2rem">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
        <span class="label" style="margin-left:auto" data-checklist-count></span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="checklist reveal" data-checklist="before-you-buy">
      {%- for block in section.blocks -%}
        <label class="check" {{ block.shopify_attributes }}>
          <input type="checkbox" value="{{ block.id }}">
          <span class="check__box" aria-hidden="true">{%- render 'icon', name: 'check' -%}</span>
          <span class="check__text">{{ block.settings.text }}</span>
        </label>
      {%- endfor -%}
    </div>

    <div class="cta-band reveal" style="margin-top:2.5rem;align-items:center">
      <div>
        <h3 class="h3">{{ section.settings.cta_heading }}</h3>
        <p class="body-copy" style="margin-top:0.5rem;max-width:44ch">{{ section.settings.cta_body }}</p>
      </div>
      <div class="cta-band__actions">
        {%- if settings.help_url != blank or settings.email != blank -%}
          <a
            class="btn btn--light"
            href="{% if settings.help_url != blank %}{{ settings.help_url }}{% else %}mailto:{{ settings.email }}{% endif %}">
            Ask us before you order
          </a>
        {%- endif -%}
        {%- if settings.phone != blank -%}
          {%- assign phone_href = settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
          <a class="btn btn--outline-light" href="tel:{{ phone_href }}">Call {{ settings.phone }}</a>
        {%- elsif settings.email != blank -%}
          <a class="btn btn--outline-light" href="mailto:{{ settings.email }}">Email {{ settings.email }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before you buy",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "11"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Checklist"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you buy."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Nine things worth confirming. Tick them off — your progress is kept on this device."
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Not sure? Ask us before you order."
    },
    {
      "type": "textarea",
      "id": "cta_body",
      "label": "CTA body",
      "default": "A five-minute conversation is cheaper than the wrong drain. Send us your measurements and we'll tell you what to order."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Checklist item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before you buy",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Have you confirmed the required drain length?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Have you confirmed the profile and grate width?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Have you confirmed the outlet position?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Have you confirmed the outlet diameter against your waste?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Have you checked the floor construction and available depth?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Have you confirmed the waterproofing requirements for your project?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Have you checked the technical drawing for your profile?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Have you confirmed this is an internal, pedestrian application?"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "If unsure, have you spoken with a qualified installer?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
