<section class="section section--charcoal on-dark" id="installation">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="split-media" style="margin-bottom:clamp(2rem,4vw,3.5rem)">
      <div class="frame frame--32 frame--dark reveal">
        {%- render 'media',
          image: section.settings.image,
          url: section.settings.image_url,
          alt: section.settings.image_alt,
          sizes: '(min-width: 64em) 48vw, 100vw',
          placeholder_label: 'Installation photography'
        -%}
      </div>
      <div class="reveal" data-reveal-delay="80">
        <div class="body-copy" style="max-width:48ch">{{ section.settings.body }}</div>
        {%- if settings.doc_installation != blank or section.settings.show_doc -%}
          <div style="margin-top:1.5rem;max-width:22rem">
            {%- render 'doc-link', url: settings.doc_installation, label: 'Installation guide', meta: 'PDF' -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <ol class="steps reveal">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <div class="body-copy" style="font-size:var(--fs-sm)">{{ block.settings.body }}</div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.disclaimer != blank -%}
      <div class="banner" style="margin-top:2rem;background:transparent;border-color:var(--line-dark);color:var(--steel-light);max-width:62ch">
        {{ section.settings.disclaimer }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Installation",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "06" },
    { "type": "text", "id": "label", "label": "Label", "default": "Installation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Installation, without the guesswork." },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Correct installation depends on your specific floor construction and plumbing configuration."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The sequence below is the shape of a typical install, not a substitute for the installation documentation or for advice from your own trades.</p><p>Waterproofing and drainage connections are regulated work. Have them carried out by a qualified plumber and waterproofer, in accordance with the requirements that apply to your project and location.</p>"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "This is general guidance only. Always follow the installation documentation supplied with your drain and the requirements that apply in your state or territory. Waterproofing and plumbing connections should be completed by appropriately qualified people."
    },
    { "type": "checkbox", "id": "show_doc", "label": "Show the installation guide download", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL", "default": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-installation-screed.jpg" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "default": "Heelguard drain body set into screed during bathroom construction, before waterproofing and tiling"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "step",
        "settings": {
          "title": "Confirm drain length and profile",
          "body": "<p>Measure the finished opening and confirm the profile depth suits your floor build-up.</p>"
        }
      },
      {
        "type": "step",
        "settings": {
          "title": "Confirm outlet position and plumbing connection",
          "body": "<p>Set the outlet position against the waste already in place, and confirm the connection method with your plumber.</p>"
        }
      },
      {
        "type": "step",
        "settings": {
          "title": "Prepare the substrate and fall",
          "body": "<p>Prepare the substrate and set the fall toward the drain so water reaches the grate rather than sitting on the floor.</p>"
        }
      },
      {
        "type": "step",
        "settings": {
          "title": "Position and secure the drain",
          "body": "<p>Position the body to the correct height for the finished tile, and secure it so it cannot move during the following trades.</p>"
        }
      },
      {
        "type": "step",
        "settings": {
          "title": "Complete waterproofing",
          "body": "<p>Waterproof in accordance with the requirements that apply to your project. This is regulated work — use a qualified waterproofer.</p>"
        }
      },
      {
        "type": "step",
        "settings": {
          "title": "Complete tiling and finishing",
          "body": "<p>Tile to the drain so the grate finishes flush, and allow for the edge bar around the grate perimeter.</p>"
        }
      },
      {
        "type": "step",
        "settings": {
          "title": "Install the grate and test drainage",
          "body": "<p>Fit the grate, then flood-test and confirm the water clears to the outlet before handover.</p>"
        }
      }
    ]
  },
  "presets": [{ "name": "Installation" }]
}
{% endschema %}
