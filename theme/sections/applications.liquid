<section class="section section--white" id="applications">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="apps reveal">
      {%- for block in section.blocks -%}
        <article class="app{% if block.settings.wide %} app--wide{% endif %}" {{ block.shopify_attributes }}>
          {%- render 'media',
            image: block.settings.image,
            url: block.settings.image_url,
            alt: block.settings.image_alt,
            sizes: '(min-width: 72em) 33vw, (min-width: 48em) 50vw, 100vw'
          -%}
          <div class="app__body">
            <h3 class="h4">{{ block.settings.title }}</h3>
            {%- if block.settings.note != blank -%}
              <p class="app__note">{{ block.settings.note }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.limits != blank -%}
      <div class="banner" style="margin-top:2rem;max-width:62ch">
        {{ section.settings.limits }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Applications",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "07"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Where it goes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for modern bathrooms."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "The Heelguard drain is made for internal wet areas. Here is where it belongs — and where it doesn't."
    },
    {
      "type": "textarea",
      "id": "limits",
      "label": "Suitability note",
      "default": "Intended for internal, pedestrian applications only. The Heelguard drain is not suitable for external areas or for vehicle traffic. If your application sits outside this, talk to us before ordering."
    }
  ],
  "blocks": [
    {
      "type": "application",
      "name": "Application",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Full-width tile",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Applications",
      "blocks": [
        {
          "type": "application",
          "settings": {
            "title": "Walk-in showers",
            "note": "A single line across the shower entry, with the fall running to the grate.",
            "wide": true,
            "image_url": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-hero-shower.jpg",
            "image_alt": "Heelguard linear drain running across the floor of a walk-in shower"
          }
        },
        {
          "type": "application",
          "settings": {
            "title": "Architectural bathrooms",
            "note": "Large-format tile and stone, where a round waste would interrupt the floor.",
            "image_url": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-lifestyle-bathroom.jpg",
            "image_alt": "Minimalist bathroom with a frameless walk-in shower and a stainless steel linear drain"
          }
        },
        {
          "type": "application",
          "settings": {
            "title": "Laundries",
            "note": "Internal laundry floor waste, in front of the machine or along the trough.",
            "image_url": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-laundry.jpg",
            "image_alt": "Modern laundry with charcoal cabinetry and a linear floor drain set flush in the tiles"
          }
        },
        {
          "type": "application",
          "settings": {
            "title": "Renovations",
            "note": "Where the waste is already set and the outlet position has to work around it.",
            "image_url": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-installation-screed.jpg",
            "image_alt": "Linear drain set into screed during a bathroom renovation"
          }
        },
        {
          "type": "application",
          "settings": {
            "title": "High-end residential",
            "note": "Brushed 304 stainless that sits alongside quality tapware rather than fighting it.",
            "image_url": "https://cdn.shopify.com/s/files/1/0721/3609/7910/files/hg-studio-product.jpg",
            "image_alt": "Stainless steel linear drain with the Heelguard grate fitted"
          }
        }
      ]
    }
  ]
}
{% endschema %}
