{%- comment -%}
  Technical documentation. Reads like an engineering sheet on purpose.
  Every annotated dimension comes from the published specification; overall
  length is the customer's choice, so it is labelled L rather than invented.
{%- endcomment -%}
<section class="section" id="technical">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="dwg reveal" data-tabs>
      <div class="dwg__tabs" role="tablist" aria-label="Profile drawings">
        {%- for block in section.blocks -%}
          <button
            class="dwg__tab"
            type="button"
            role="tab"
            id="dwg-tab-{{ block.id }}"
            aria-controls="dwg-panel-{{ block.id }}"
            aria-selected="false"
            tabindex="-1"
            {{ block.shopify_attributes }}>
            {{ block.settings.width }}mm profile
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- liquid
          assign w = block.settings.width | plus: 0
          assign d = block.settings.depth | plus: 0
          case w
            when 70
              assign doc_url = settings.doc_drawing_70
            when 85
              assign doc_url = settings.doc_drawing_85
            else
              assign doc_url = settings.doc_drawing_100
          endcase
        -%}
        <div
          class="dwg__panel"
          role="tabpanel"
          id="dwg-panel-{{ block.id }}"
          aria-labelledby="dwg-tab-{{ block.id }}"
          hidden>
          <div class="dwg__sheet">
            <div class="dwg__sheet-head">
              <span>Heelguard linear drain — {{ w }}mm profile</span>
              <span>Dimensions in millimetres</span>
            </div>
            {%- render 'drawing',
              w: w,
              d: d,
              outlet_dia: block.settings.outlet_dia,
              outlet_pos: block.settings.outlet_pos
            -%}
          </div>

          <div style="display:grid;gap:1.75rem;align-content:start">
            <table class="spec-table">
              <caption class="visually-hidden">Specification for the {{ w }}mm Heelguard profile</caption>
              <tbody>
                <tr><th scope="row">Profile width</th><td>{{ w }} mm</td></tr>
                <tr><th scope="row">Profile depth</th><td>{{ d }} mm</td></tr>
                <tr><th scope="row">Material</th><td>304 stainless steel</td></tr>
                <tr><th scope="row">Construction</th><td>Fully welded</td></tr>
                <tr><th scope="row">Grate</th><td>Heelguard wedge wire — 3 mm wire, 4 mm aperture</td></tr>
                <tr><th scope="row">Edge bar</th><td>5 × 20 mm deep, full perimeter</td></tr>
                <tr><th scope="row">Cross bars</th><td>Tapered, at approximately 25 mm centres</td></tr>
                <tr><th scope="row">Outlet options</th><td>{{ block.settings.outlets }}</td></tr>
                <tr><th scope="row">Length</th><td>Selected at order. Custom lengths on request.</td></tr>
                <tr><th scope="row">Application</th><td>Internal, pedestrian areas only</td></tr>
              </tbody>
            </table>

            <div class="dwg__dl">
              <p class="label">Downloads</p>
              {%- render 'doc-link',
                url: doc_url,
                label: 'Technical drawing — ' | append: w | append: 'mm',
                meta: 'PDF'
              -%}
              {%- render 'doc-link', url: settings.doc_spec_sheet, label: 'Specification sheet', meta: 'PDF' -%}
            </div>

            <p class="dwg__note">
              {{ section.settings.note }}
            </p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Technical drawings",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "05"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Technical"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technical information, without the guesswork."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Plan, elevation and section for each profile. Check the depth against your floor build-up and the outlet against your plumbing before you order."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Sheet note",
      "default": "Plan and elevation are schematic in length; section A–A is drawn to scale. Only the dimensions shown are specified. Confirm the drain against your own plans and your installer's requirements before ordering."
    }
  ],
  "blocks": [
    {
      "type": "profile",
      "name": "Profile",
      "settings": [
        {
          "type": "text",
          "id": "width",
          "label": "Width (mm)",
          "default": "70"
        },
        {
          "type": "text",
          "id": "depth",
          "label": "Depth (mm)",
          "default": "22"
        },
        {
          "type": "text",
          "id": "outlet_dia",
          "label": "Outlet diameter label",
          "default": "50.8"
        },
        {
          "type": "select",
          "id": "outlet_pos",
          "label": "Outlet position shown",
          "default": "centre",
          "options": [
            {
              "value": "centre",
              "label": "Centre"
            },
            {
              "value": "end",
              "label": "End"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "outlets",
          "label": "Outlet options text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technical drawings",
      "blocks": [
        {
          "type": "profile",
          "settings": {
            "width": "70",
            "depth": "22",
            "outlet_dia": "50.8",
            "outlet_pos": "centre",
            "outlets": "50.8 OD centre outlet · DIY 50 mm outlet option"
          }
        },
        {
          "type": "profile",
          "settings": {
            "width": "85",
            "depth": "20",
            "outlet_dia": "50.8",
            "outlet_pos": "centre",
            "outlets": "50.8 OD centre outlet · end outlet, 50 mm from end to centre · DIY 50 mm outlet · DIY 76 mm outlet with flange"
          }
        },
        {
          "type": "profile",
          "settings": {
            "width": "100",
            "depth": "20",
            "outlet_dia": "80",
            "outlet_pos": "centre",
            "outlets": "80 mm OD centre outlet · DIY 50 mm outlet · DIY 76 mm outlet with flange"
          }
        }
      ]
    }
  ]
}
{% endschema %}
