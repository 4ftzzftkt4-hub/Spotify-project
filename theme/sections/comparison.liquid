{%- comment -%}
  Educational comparison. Describes grate styles objectively — no competitor
  is named and no rival product is disparaged. The purpose is that the customer
  can tell whether Heelguard is the right pattern for them.
{%- endcomment -%}
<section class="section section--paper2" id="compare">
  <div class="wrap">
    <div class="sec-head sec-head--split reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.intro }}</p>
    </div>

    <div class="tscroll reveal" style="background:var(--white);border:1px solid var(--line)">
      <table class="cmp">
        <caption class="visually-hidden">{{ section.settings.heading }}</caption>
        <thead>
          <tr>
            <th scope="col">Consideration</th>
            <th scope="col" class="is-hero">{{ section.settings.col_1 }}</th>
            <th scope="col">{{ section.settings.col_2 }}</th>
            <th scope="col">{{ section.settings.col_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.row }}</th>
              <td class="is-hero">{{ block.settings.a }}</td>
              <td>{{ block.settings.b }}</td>
              <td>{{ block.settings.c }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <p class="form-note reveal" style="margin-top:1.25rem;max-width:62ch">{{ section.settings.note }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Choosing a grate style",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "10"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Choosing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choosing the right grate style."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Linear drains mostly differ at the grate. Here is how the common styles behave, so you can decide whether Heelguard is the right pattern for your bathroom."
    },
    {
      "type": "text",
      "id": "col_1",
      "label": "Column 1",
      "default": "Heelguard wedge wire"
    },
    {
      "type": "text",
      "id": "col_2",
      "label": "Column 2",
      "default": "Open grid / slotted"
    },
    {
      "type": "text",
      "id": "col_3",
      "label": "Column 3",
      "default": "Tile insert"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "General characteristics of each style, offered as education rather than a test result. Choose the pattern that suits your floor, your cleaning habits and how the bathroom is used."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "row",
          "label": "Consideration"
        },
        {
          "type": "text",
          "id": "a",
          "label": "Heelguard"
        },
        {
          "type": "text",
          "id": "b",
          "label": "Open grid"
        },
        {
          "type": "text",
          "id": "c",
          "label": "Tile insert"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Choosing a grate style",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "row": "Appearance",
            "a": "A fine, even stainless line across the floor",
            "b": "Visible openings; pattern reads more strongly",
            "c": "Near-invisible — reads as continuous tile"
          }
        },
        {
          "type": "row",
          "settings": {
            "row": "Grate style",
            "a": "3mm wedge wire at 4mm aperture, tapered bars",
            "b": "Wider slots or a punched pattern",
            "c": "Recessed tray that carries a cut tile"
          }
        },
        {
          "type": "row",
          "settings": {
            "row": "Underfoot",
            "a": "Narrow apertures support the heel across the grate",
            "b": "Wider openings are felt more underfoot",
            "c": "Feels like the surrounding tile"
          }
        },
        {
          "type": "row",
          "settings": {
            "row": "Cleaning",
            "a": "Grate lifts out; tapered bars shed grime",
            "b": "Grate lifts out; openings are easy to see into",
            "c": "Tray lifts out, but is heavier with the tile fitted"
          }
        },
        {
          "type": "row",
          "settings": {
            "row": "Best suited to",
            "a": "Bathrooms where the floor is walked on barefoot",
            "b": "Utility spaces and high-debris areas",
            "c": "Floors where the drain should disappear"
          }
        },
        {
          "type": "row",
          "settings": {
            "row": "Installation",
            "a": "Standard linear install; confirm depth and outlet",
            "b": "Standard linear install",
            "c": "Requires tile cutting and extra build-up allowance"
          }
        }
      ]
    }
  ]
}
{% endschema %}
