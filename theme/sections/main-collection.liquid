<section class="section">
  <div class="wrap">
    <div class="sec-head" style="margin-bottom:2.5rem">
      <div class="sec-head__meta"><span class="label">Collection</span></div>
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="lede rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
    {%- if collection.products.size == 0 -%}
      <p class="lede">Nothing in this collection yet.</p>
    {%- else -%}
      <div class="grid grid--3">
        {%- for product in collection.products -%}
          <a class="card" href="{{ product.url }}">
            <div class="card__media">
              {%- if product.featured_image -%}
                {%- render 'media',
                  image: product.featured_image,
                  sizes: '(min-width: 72em) 33vw, (min-width: 48em) 50vw, 100vw',
                  ratio: '3/2'
                -%}
              {%- endif -%}
            </div>
            <span class="label">{{ product.vendor }}</span>
            <h2 class="h4">{{ product.title }}</h2>
            <span class="mono" style="font-weight:600">
              {%- if product.price_varies -%}From {% endif -%}
              {{ product.price_min | money }}
            </span>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="chips" style="margin-top:2.5rem" aria-label="{{ 'general.pagination.label' | t }}">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="chip" href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="chip" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
