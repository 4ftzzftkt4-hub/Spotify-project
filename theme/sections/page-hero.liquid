<section class="phero on-dark">
  <div class="wrap">
    <div class="phero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span>{{ section.settings.heading | default: page.title }}</span>
      </nav>
      <h1 class="h1 phero__title">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.lede != blank -%}
        <p class="lede phero__lede">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "textarea", "id": "lede", "label": "Intro" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
