<section class="section section--paper2" id="included">
  <div class="wrap">
    <div class="sec-head reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <div class="sec-head__meta">
        <span class="index">{{ section.settings.index }}</span>
        <span class="label">{{ section.settings.label }}</span>
      </div>
      <h2 class="h1">{{ section.settings.heading }}</h2>
    </div>

    <div class="wyg reveal">
      <div class="wyg__panel">
        <div class="wyg__head">
          <h3 class="h3">{{ section.settings.included_title }}</h3>
          <span class="label">In every order</span>
        </div>
        <div class="ticks">
          {%- assign items = section.settings.included | split: ',' -%}
          {%- for i in items -%}
            {%- assign i = i | strip -%}
            {%- if i != blank -%}
              <span class="tick">
                <span class="tick__mark" aria-hidden="true">{%- render 'icon', name: 'check' -%}</span>
                {{ i }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.included_note != blank -%}
          <p class="form-note">{{ section.settings.included_note }}</p>
        {%- endif -%}
      </div>

      <div class="wyg__panel wyg__panel--optional">
        <div class="wyg__head">
          <h3 class="h3">{{ section.settings.optional_title }}</h3>
          <span class="label">On request</span>
        </div>
        <div class="ticks">
          {%- assign opts = section.settings.optional | split: ',' -%}
          {%- for i in opts -%}
            {%- assign i = i | strip -%}
            {%- if i != blank -%}
              <span class="tick">
                <span class="tick__mark" aria-hidden="true" style="color:var(--ink-40)">{%- render 'icon', name: 'plus' -%}</span>
                {{ i }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.optional_note != blank -%}
          <p class="form-note">{{ section.settings.optional_note }}</p>
        {%- endif -%}
        {%- if section.settings.optional_cta_label != blank -%}
          <a class="tlink" href="{{ section.settings.optional_cta_url | default: '#' }}" style="justify-self:start">
            {{ section.settings.optional_cta_label }}
            <span style="width:15px" aria-hidden="true">{%- render 'icon', name: 'arrow-right' -%}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What you get",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "08" },
    { "type": "text", "id": "label", "label": "Label", "default": "What you get" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Exactly what arrives." },
    { "type": "text", "id": "included_title", "label": "Included title", "default": "Included" },
    {
      "type": "textarea",
      "id": "included",
      "label": "Included items",
      "info": "Comma separated. List only what you actually ship.",
      "default": "Heelguard wedge-wire grate, Linear drain body in 304 stainless steel, Outlet components for the configuration you select"
    },
    {
      "type": "text",
      "id": "included_note",
      "label": "Included note",
      "default": "Confirm the contents against your order confirmation. If anything is missing, contact us before installing."
    },
    { "type": "text", "id": "optional_title", "label": "Optional title", "default": "Optional" },
    {
      "type": "textarea",
      "id": "optional",
      "label": "Optional items",
      "info": "Comma separated. Ask about availability before promising these to a customer.",
      "default": "Hair and debris strainer"
    },
    {
      "type": "text",
      "id": "optional_note",
      "label": "Optional note",
      "default": "Optional items are quoted per project — ask us what is available for your configuration."
    },
    { "type": "text", "id": "optional_cta_label", "label": "Link label", "default": "Ask about options" },
    { "type": "url", "id": "optional_cta_url", "label": "Link" }
  ],
  "presets": [{ "name": "What you get" }]
}
{% endschema %}
