<section class="section{% if section.settings.dark %} section--dark on-dark{% endif %}{% if section.settings.tight %} section--tight{% endif %}">
  <div class="wrap wrap--narrow">
    <div class="reveal" style="display:grid;gap:1.5rem;max-width:{{ section.settings.max_width }}">
      {%- if section.settings.label != blank -%}
        <div class="sec-head__meta">
          {%- if section.settings.index != blank -%}<span class="index">{{ section.settings.index }}</span>{%- endif -%}
          <span class="label">{{ section.settings.label }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="rte body-copy">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="btn{% if section.settings.dark %} btn--light{% endif %}" href="{{ section.settings.cta_url | default: '#' }}" style="justify-self:start">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "index", "label": "Index" },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "h3", "label": "Small" }
      ]
    },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "max_width", "label": "Max width", "default": "46rem" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    { "type": "checkbox", "id": "tight", "label": "Reduced padding", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
