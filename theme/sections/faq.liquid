{%- comment -%}
  FAQ with FAQPage structured data built from the same blocks, so the schema and
  the visible answers can never disagree.
{%- endcomment -%}
<section class="section" id="faq">
  <div class="wrap">
    <div class="faq">
      <div class="reveal">
        <div class="sec-head">
          <div class="sec-head__meta">
            <span class="index">{{ section.settings.index }}</span>
            <span class="label">{{ section.settings.label }}</span>
          </div>
          <h2 class="h1">{{ section.settings.heading }}</h2>
          <p class="lede">{{ section.settings.intro }}</p>
        </div>

        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--ghost" href="{{ section.settings.cta_url | default: settings.help_url | default: '#' }}" style="margin-top:2rem">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="faq__groups reveal" data-reveal-delay="80">
        {%- assign groups = section.blocks | map: 'settings' | map: 'group' | uniq -%}
        {%- for group in groups -%}
          <div>
            {%- if group != blank -%}<h3 class="faq__group-title">{{ group }}</h3>{%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.group == group -%}
                <details class="disclosure" {{ block.shopify_attributes }}>
                  <summary class="disclosure__summary">
                    {{ block.settings.question }}
                    <span class="disclosure__icon" aria-hidden="true"></span>
                  </summary>
                  <div class="disclosure__body body-copy">{{ block.settings.answer }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.enable_schema -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "12" },
    { "type": "text", "id": "label", "label": "Label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know your drain before you order." },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "The questions we actually get asked, answered from the specification rather than from marketing copy."
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Ask a question of your own" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Output FAQ structured data",
      "default": true,
      "info": "Adds FAQPage schema built from these exact questions and answers."
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "group", "label": "Group", "default": "The product" },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
