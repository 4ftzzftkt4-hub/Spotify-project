<section class="section{% if section.settings.dark %} section--dark on-dark{% endif %}">
  <div class="wrap wrap--narrow">
    <div class="sec-head reveal" style="margin-bottom:2rem">
      {%- if section.settings.label != blank -%}
        <div class="sec-head__meta">
          {%- if section.settings.index != blank -%}<span class="index">{{ section.settings.index }}</span>{%- endif -%}
          <span class="label">{{ section.settings.label }}</span>
        </div>
      {%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>

    <table class="spec-table reveal">
      <caption class="visually-hidden">{{ section.settings.heading }}</caption>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.key }}</th>
            <td>{{ block.settings.value }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

{% schema %}
{
  "name": "Specification table",
  "settings": [
    { "type": "text", "id": "index", "label": "Index" },
    { "type": "text", "id": "label", "label": "Label", "default": "Specification" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Full specification" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "key", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    }
  ],
  "presets": [{ "name": "Specification table" }]
}
{% endschema %}
