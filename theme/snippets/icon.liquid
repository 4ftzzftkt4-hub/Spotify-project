{%- comment -%}
  Inline icon set. Usage: {% render 'icon', name: 'arrow-right' %}
  All icons are 24×24, stroke-based, currentColor, decorative by default.
{%- endcomment -%}
{%- liquid
  assign s = 'width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"'
-%}
{%- case name -%}
  {%- when 'menu' -%}
    <svg {{ s }}><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg {{ s }}><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'cart' -%}
    <svg {{ s }}><path d="M3 5h3l2.2 11h10.3L21 8H6.4"/><circle cx="9.5" cy="20" r="1.3" fill="currentColor" stroke="none"/><circle cx="18" cy="20" r="1.3" fill="currentColor" stroke="none"/></svg>
  {%- when 'search' -%}
    <svg {{ s }}><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
  {%- when 'phone' -%}
    <svg {{ s }}><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 12l5 2v4a2 2 0 0 1-2.2 2A16 16 0 0 1 3 5.2 2 2 0 0 1 5 3z"/></svg>
  {%- when 'mail' -%}
    <svg {{ s }}><rect x="3" y="5" width="18" height="14"/><path d="M3 6l9 7 9-7"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ s }}><path d="M4 12h15M13 6l6 6-6 6"/></svg>
  {%- when 'arrow-left' -%}
    <svg {{ s }}><path d="M20 12H5M11 6l-6 6 6 6"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ s }} viewBox="0 0 12 8" style="width:100%"><path d="M1 1l5 5 5-5"/></svg>
  {%- when 'check' -%}
    <svg {{ s }} stroke-width="2.2"><path d="M4 12.5l5 5L20 6.5"/></svg>
  {%- when 'plus' -%}
    <svg {{ s }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg {{ s }}><path d="M5 12h14"/></svg>
  {%- when 'zoom' -%}
    <svg {{ s }}><circle cx="11" cy="11" r="6.5"/><path d="M11 8.5v5M8.5 11h5M16 16l4.5 4.5"/></svg>
  {%- when 'help' -%}
    <svg {{ s }}><circle cx="12" cy="12" r="9"/><path d="M9.3 9.2a2.7 2.7 0 1 1 3.9 2.4c-.8.5-1.2 1-1.2 1.9"/><circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.5l-5.9 3.2 1.2-6.6L2.5 9.5l6.6-.9z"/></svg>
  {%- when 'star-outline' -%}
    <svg {{ s }}><path d="M12 3.4l2.7 5.6 6.1.9-4.4 4.2 1.1 6.1L12 17.3l-5.5 2.9 1.1-6.1-4.4-4.2 6.1-.9z"/></svg>
  {%- when 'download' -%}
    <svg {{ s }}><path d="M12 3v11M7.5 10L12 14.5 16.5 10M4 20h16"/></svg>
  {%- when 'heel' -%}
    <svg {{ s }}><path d="M8 3c3 0 4.5 2 4.5 4.5S11 11 11 13c0 2.2 1.8 3 3.5 3.6 1.7.6 2.5 1.6 2.5 3.4"/><path d="M4 21h16"/></svg>
  {%- when 'paw' -%}
    <svg {{ s }}><ellipse cx="8" cy="8.5" rx="1.7" ry="2.3"/><ellipse cx="13" cy="7" rx="1.7" ry="2.3"/><ellipse cx="17.5" cy="10" rx="1.7" ry="2.3"/><path d="M8.4 14.6c1.6-2 4.6-2 6.2 0 1.5 1.9.4 4.4-2 4.4h-2.2c-2.4 0-3.5-2.5-2-4.4z"/></svg>
  {%- when 'flow' -%}
    <svg {{ s }}><path d="M3 7h18M3 12h18M3 17h18" stroke-dasharray="3 3"/><path d="M12 3v18M8 17l4 4 4-4"/></svg>
  {%- when 'clean' -%}
    <svg {{ s }}><path d="M9 3h6v6H9zM7 9h10l1 12H6z"/><path d="M9 13v4M12 13v4M15 13v4"/></svg>
  {%- when 'steel' -%}
    <svg {{ s }}><rect x="3" y="6" width="18" height="12"/><path d="M6 6v12M10 6v12M14 6v12M18 6v12"/></svg>
  {%- when 'tools' -%}
    <svg {{ s }}><path d="M14.5 3.5a4.2 4.2 0 0 0 5.5 5.5L21 10l-3 3-9.5 9.5-3-3L15 10l-1.5-1.5z"/><path d="M4 4l4 4"/></svg>
  {%- when 'weld' -%}
    <svg {{ s }}><path d="M3 12h18"/><path d="M5 12l2-3 2 3 2-3 2 3 2-3 2 3"/></svg>
  {%- when 'ruler' -%}
    <svg {{ s }}><rect x="2" y="9" width="20" height="6"/><path d="M6 9v3M10 9v3M14 9v3M18 9v3"/></svg>
  {%- when 'truck' -%}
    <svg {{ s }}><path d="M2 6h11v10H2zM13 9h4.5L21 12.5V16h-8"/><circle cx="6" cy="18.5" r="1.5"/><circle cx="17" cy="18.5" r="1.5"/></svg>
  {%- when 'doc' -%}
    <svg {{ s }}><path d="M6 2h8l5 5v15H6z"/><path d="M14 2v5h5M9 12h7M9 16h7"/></svg>
  {%- else -%}
    <svg {{ s }}><circle cx="12" cy="12" r="9"/></svg>
{%- endcase -%}
