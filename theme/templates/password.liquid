<div style="display:grid;gap:1.5rem">
  <p class="lede">{{ shop.password_message }}</p>
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="banner banner--err" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div style="display:grid;gap:1rem;max-width:22rem">
      <div class="field">
        <label class="field__label" for="sf-pass">Password</label>
        <input class="field__input" id="sf-pass" type="password" name="password" autocomplete="current-password">
      </div>
      <button class="btn" type="submit">Enter</button>
    </div>
  {%- endform -%}
</div>
