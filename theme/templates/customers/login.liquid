<section class="section">
  <div class="wrap wrap--narrow">
    <div style="max-width:26rem;display:grid;gap:1.5rem">
      <h1 class="h2">Sign in</h1>
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="banner banner--err" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div style="display:grid;gap:1.25rem">
          <div class="field">
            <label class="field__label" for="login-email">Email</label>
            <input class="field__input" id="login-email" type="email" name="customer[email]" autocomplete="email" required>
          </div>
          <div class="field">
            <label class="field__label" for="login-password">Password</label>
            <input class="field__input" id="login-password" type="password" name="customer[password]" autocomplete="current-password">
          </div>
          <button class="btn btn--full" type="submit">Sign in</button>
          <a class="tlink" href="{{ routes.account_register_url }}" style="justify-self:start">Create an account</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
