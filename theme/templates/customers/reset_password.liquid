<section class="section">
  <div class="wrap wrap--narrow">
    <div style="max-width:26rem;display:grid;gap:1.5rem">
      <h1 class="h2">Reset your password</h1>
      {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="banner banner--err" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div style="display:grid;gap:1.25rem">
          <div class="field">
            <label class="field__label" for="rp-1">New password</label>
            <input class="field__input" id="rp-1" type="password" name="customer[password]" autocomplete="new-password">
          </div>
          <div class="field">
            <label class="field__label" for="rp-2">Confirm password</label>
            <input class="field__input" id="rp-2" type="password" name="customer[password_confirmation]" autocomplete="new-password">
          </div>
          <button class="btn btn--full" type="submit">Reset password</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
